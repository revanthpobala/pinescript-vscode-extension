{
  "name": "pine-script-pro",
  "displayName": "Pine Script Pro",
  "description": "Professional Language Support for Pine Script. Static analysis, type-infection checking, and intelligent tooltips for advanced TradingView developers.",
  "version": "1.4.0",
  "license": "SEE LICENSE IN LICENSE",
  "publisher": "revanthpobala",
  "author": "Revanth Pobala",
  "repository": {
    "type": "git",
    "url": "https://github.com/revanthpobala/pinescript-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/revanthpobala/pinescript-vscode-extension/issues"
  },
  "homepage": "https://github.com/revanthpobala/pinescript-vscode-extension",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#089981",
    "theme": "dark"
  },
  "keywords": [
    "pinescript",
    "tradingview",
    "pine script",
    "trading",
    "finance",
    "analyzer",
    "checker",
    "tradingview",
    "tradingview tools"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Education"
  ],
  "main": "./client/out/extension.js",
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "pinescript",
        "aliases": [
          "Pine Script",
          "pine"
        ],
        "extensions": [
          ".pine"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pinescript",
        "scopeName": "source.pinescript",
        "path": "./syntaxes/pinescript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pinescript",
        "path": "./snippets/pinescript.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pinescript-preview",
          "title": "Pine Script Preview",
          "icon": "resources/preview-icon.svg"
        }
      ]
    },
    "views": {
      "pinescript-preview": [
        {
          "type": "webview",
          "id": "pinescript.inputPreview",
          "name": "Settings Preview"
        }
      ]
    },
    "commands": [
      {
        "command": "pinescript.showInputPreview",
        "title": "Pine Script: Show Input UI Preview",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pinescript.showInputPreview",
          "when": "resourceLangId == pinescript",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "compile": "cd client && npm run compile && cd ../server && npm run compile",
    "bundle": "node esbuild.js --production",
    "watch": "tsc -b -w",
    "lint": "eslint ./client/src ./server/src --ext .ts,.tsx",
    "vscode:prepublish": "npm run bundle",
    "publish:vscode": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.1",
    "fs-extra": "^11.3.5",
    "typescript": "^6.0.3"
  }
}