{
  "name": "pine-script-extension-server",
  "description": "Pine Script v6 Language Server",
  "version": "1.2.1",
  "author": "Revanth Pobala",
  "main": "./out/server.js",
  "scripts": {
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "debug": "node tools/debug_diagnostics.js",
    "build": "npm run compile && cp wasm/tree-sitter-pinescript.wasm out/src/ && cp -r src/data out/src/ && cp test/cases.json out/test/",
    "postinstall": "mkdir -p out && cp wasm/tree-sitter-pinescript.wasm out/"
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.5.4",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
